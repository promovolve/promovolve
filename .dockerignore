# Keep the api build context lean (Dockerfile.api copies build.sbt,
# project/, modules/ — everything else is noise that bloats the context).
.git
.idea
.bsp
.claude
**/target
target
**/ddata-promovolve-*
**/ddata
book
docs
platform
scripts
*.md
.scalafmt.conf
.DS_Store
private
# Git exclusions do not apply to Docker build contexts.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.tfstate
**/*.tfstate.*
**/.terraform
**/.ssh
**/.kube
