# The Go build needs go.mod/go.sum, the Go sources, and the embedded
# static/ + templates/ dirs. Everything below is excluded from context.
.git
**/node_modules
**/target
banner-bootstrap
banner-component
creative-designer
bin
*.test
.DS_Store
# Git exclusions do not apply to Docker build contexts.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.tfstate
**/*.tfstate.*
**/.terraform
**/.ssh
**/.kube
