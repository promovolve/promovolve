{
  "name": "@promovolve/creative-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard UI for authoring expandable-magazine-banner creatives — canvas, drag/resize/rotate, per-size layouts, asset library. TypeScript + Vite, shares types with @promovolve/banner-component.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "serve": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "fanout": "node scripts/fanout.mjs",
    "release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run fanout",
    "test:ratchet": "node tests/ratchet/run.mjs",
    "test:start-sync": "node tests/ratchet/start-sync.mjs",
    "test:anim-viewability": "node tests/ratchet/anim-viewability.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.6.2",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
